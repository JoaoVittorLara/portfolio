---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { FORMACAO } from '../consts';
import linhas from '../assets/formacao/linhas.svg?url';

/*
  Um card por formação: área de arte com linhas e brilho, o logo da
  instituição num quadro branco e o texto embaixo.

  O quadro é o único branco puro do site: as cores dos logos foram desenhadas
  sobre branco e ficariam esverdeadas no fundo claro do site.

  O logo tem alt vazio porque o nome da instituição está escrito logo abaixo;
  o leitor de tela diria o nome duas vezes.

  Logos resolvidos por glob, como os screenshots: arquivo ausente não quebra o
  build. Os cards não são links, então o hover só existe com mouse e o card não
  recebe foco.
*/
const logos = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/formacao/*.{png,jpg,jpeg,webp,avif}',
  { eager: true },
);
const logoDe = (id: string) =>
  Object.entries(logos).find(([caminho]) => caminho.includes(`/${id}.`))?.[1]
    .default;

// O Astro não aumenta imagem: a maior largura pedida para na do arquivo.
const larguras = (img: ImageMetadata) => [
  ...new Set([160, 320].map((w) => Math.min(w, img.width))),
];
---

<section id="formacao" class="veu" aria-labelledby="formacao-titulo">
  <div class="casca secao">
  <h2 id="formacao-titulo" data-revela>Formação</h2>

  {/*
    O data-revela fica na lista, e não em cada card: o card já tem transição
    de `transform` para o hover, e duas transições na mesma propriedade brigam.
  */}
  <ul
    class="cards"
    role="list"
    style={`--linhas: url("${linhas}")`}
    data-revela
  >
    {
      FORMACAO.map((f) => {
        const logo = logoDe(f.logo);
        return (
          <li class="card vidro">
            <div class="arte" aria-hidden="true">
              {logo && (
                <span class="quadro">
                  <Image
                    class="logo"
                    src={logo}
                    alt=""
                    widths={larguras(logo)}
                    sizes="92px"
                  />
                </span>
              )}
            </div>
            <div class="texto">
              <p class="curso">{f.curso}</p>
              <p class="instituicao">{f.instituicao}</p>
              <p class="periodo">
                {f.periodo} <span aria-hidden="true">·</span> {f.status}
              </p>
            </div>
          </li>
        );
      })
    }
  </ul>
  </div>
</section>

<style>
  /* Os cards têm fundo próprio e o título é texto principal: véu mais aberto. */
  section {
    --veu: 0.72;
  }

  .cards {
    list-style: none;
    margin-top: var(--sp-l);
    display: grid;
    gap: var(--sp-l);
  }

  @media (min-width: 44rem) {
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /*
    Card de vidro fosco. No hover, o ::before é um anel de 1,5px: um
    conic-gradient recortado por máscara para existir só na borda (o miolo é
    translúcido, e um anel cheio vazaria pelo vidro). O giro anima o ângulo do
    gradiente, que precisa ser uma propriedade registrada (@property) para
    poder ser animado.
  */
  @property --angulo {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0turn;
  }

  .card {
    position: relative;
    border: 1.5px solid var(--linha-suave);
    border-radius: var(--radius-card);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .card::before {
    content: '';
    position: absolute;
    inset: -1.5px;
    padding: 1.5px;
    border-radius: var(--radius-card);
    pointer-events: none;
    background: conic-gradient(
      from var(--angulo),
      transparent 0turn,
      transparent 0.62turn,
      var(--ink) 0.86turn,
      transparent 1turn
    );
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 300ms ease-out;
    animation: anel 3.2s linear infinite paused;
  }

  @keyframes anel {
    to {
      --angulo: 1turn;
    }
  }

  /*
    A área de arte não tem texto, então o brilho pode ser forte aqui (14%)
    sem ferir contraste nenhum.
  */
  .arte {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: calc(var(--radius-card) - 1.5px)
      calc(var(--radius-card) - 1.5px) 0 0;
    background: radial-gradient(
      55% 60% at 50% 45%,
      rgb(227 236 226 / 0.14),
      transparent 70%
    );
  }

  /* As linhas moram num pseudo-elemento para poderem ser espelhadas sem
     virar o logo junto. O segundo card é o espelho do primeiro. */
  .arte::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--linhas) center / cover no-repeat;
  }

  .card:nth-child(2n) .arte::before {
    transform: scaleX(-1);
  }

  .quadro {
    position: relative;
    display: grid;
    place-items: center;
    width: 6.5rem;
    aspect-ratio: 1;
    padding: 0.875rem;
    background: #fff;
    border-radius: var(--radius-card);
    transition: transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .texto {
    display: grid;
    gap: var(--sp-2xs);
    padding: var(--sp-m) var(--sp-l) var(--sp-l);
  }

  .curso {
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.3;
  }

  .periodo {
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  @media (min-width: 40rem) {
    .quadro {
      width: 7.5rem;
    }
  }

  /*
    Só em aparelho com mouse. No celular, o toque "gruda" o hover, e o card
    ficaria crescido depois de um toque.
  */
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: scale(1.03);
    }

    .card:hover::before {
      opacity: 1;
      animation-play-state: running;
    }

    .card:hover .quadro {
      transform: scale(1.06);
    }
  }

  /* Movimento reduzido: nada cresce e nada gira. No hover, o anel aparece
     inteiro e parado. */
  @media (prefers-reduced-motion: reduce) {
    .card::before {
      animation: none;
      background: var(--ink);
    }

    .card:hover,
    .card:hover .quadro {
      transform: none;
    }
  }
</style>
