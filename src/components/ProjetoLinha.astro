---
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Destaques from './Destaques.astro';

interface Props {
  projeto: CollectionEntry<'projetos'>;
}

const { projeto } = Astro.props;
const d = projeto.data;
const tituloId = `projeto-${projeto.id}`;

/*
  O screenshot é achado por glob, pelo id do projeto, e não por caminho no
  frontmatter: com `image()`, um arquivo ausente quebraria o build inteiro.
  Adicionar o screenshot de um projeto é colocar um arquivo com o nome do id em
  src/assets/projetos/.
*/
const screenshots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projetos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const screenshot = Object.entries(screenshots).find(([caminho]) =>
  caminho.includes(`/${projeto.id}.`),
)?.[1].default;
---

{/*
  Linha de largura total, não card em grade: com três projetos, uma grade de
  três colunas fica rala. Na home, a linha diz o que o site faz; os detalhes
  técnicos ficam em /projetos/, pelo "Como eu fiz".
*/}
<article class="linha" aria-labelledby={tituloId} data-revela>
  {/*
    Mesmo `transition:name` do screenshot no card de /projetos/: na troca de
    página, o navegador anima uma imagem na outra (View Transitions, pelo
    ClientRouter). O Astro já desliga a animação com movimento reduzido.
  */}
  <div class="figura" transition:name={`screenshot-${projeto.id}`}>
    {
      screenshot ? (
        <Image
          src={screenshot}
          alt={d.screenshotAlt ?? `Captura de tela do projeto ${d.titulo}`}
          widths={[320, 640, 960]}
          sizes="(min-width: 48rem) 20rem, 100vw"
          loading="lazy"
        />
      ) : (
        /* Sem screenshot, avisa em vez de disfarçar com uma imagem genérica. */
        <p class="sem-imagem">
          sem screenshot
          <span>este projeto não vai pro ar assim</span>
        </p>
      )
    }
  </div>

  <div class="corpo">
    <p class="rotulo">Projeto {d.tipo}</p>
    <h3 id={tituloId}>{d.titulo}</h3>
    <p class="resumo medida">{d.resumo}</p>

    {d.destaques && <Destaques itens={d.destaques} />}

    {/*
      "Ver o site" é a ação principal e abre em aba nova. "Como eu fiz" leva à
      âncora do card do projeto em /projetos/.
    */}
    <p class="acoes">
      <a class="btn" href={d.demo} target="_blank" rel="noopener">
        Ver o site<span class="vh"> (abre em nova aba)</span>
      </a>
      <a class="como" href={`/projetos/#${projeto.id}`}>Como eu fiz</a>
    </p>
  </div>
</article>

<style>
  .linha {
    display: grid;
    gap: var(--sp-m);
    padding-block: var(--sp-xl);
    border-top: 1px solid var(--rule);
  }

  .linha:first-of-type {
    border-top: 0;
    padding-top: var(--sp-l);
  }

  /* 2:1, a proporção real dos screenshots (cerca de 1900x940). Em 16:9, o
     cover cortaria uns 14% das laterais. */
  .figura img,
  .sem-imagem {
    aspect-ratio: 2 / 1;
    width: 100%;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    object-fit: cover;
  }

  /*
    Hover: zoom leve no screenshot e borda mais forte. Só com mouse fino, para
    o estado não ficar "grudado" depois de um toque.
  */
  .figura img {
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      border-color 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @media (hover: hover) and (pointer: fine) {
    .figura:hover img {
      transform: scale(1.02);
      border-color: var(--ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .figura:hover img {
      transform: none;
    }
  }

  .sem-imagem {
    margin: 0;
    border-style: dashed;
    display: grid;
    place-content: center;
    gap: var(--sp-2xs);
    text-align: center;
    padding: var(--sp-m);
    font-size: var(--step--2);
    color: var(--ink-muted);
    background: var(--surface);
  }

  .sem-imagem span {
    display: block;
  }

  .corpo {
    display: flex;
    flex-direction: column;
    gap: var(--sp-s);
    min-width: 0;
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-s) var(--sp-l);
    margin-top: var(--sp-xs);
  }

  .como {
    display: inline-flex;
    align-items: center;
    min-height: var(--toque);
    font-weight: 700;
  }

  @media (min-width: 48rem) {
    .linha {
      grid-template-columns: 20rem 1fr;
      gap: var(--sp-xl);
      align-items: start;
    }
  }
</style>
