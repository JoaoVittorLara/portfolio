---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { render } from 'astro:content';
import Destaques from './Destaques.astro';
import Icone from './Icone.astro';
import VideoProjeto from './VideoProjeto.astro';
import MedicaoProjeto from './MedicaoProjeto.astro';
import { linkWhatsApp } from '../lib/whatsapp';

/*
  Um projeto, como card da pilha de /projetos/. O título é `h2` (o `h1` da
  página é "Projetos") e as seções internas são `h3`.

  A chamada do WhatsApp aparece em todo card, de propósito: quem se convence
  no primeiro projeto não precisa rolar a página inteira para achar o botão.
*/
interface Props {
  projeto: CollectionEntry<'projetos'>;
  /** Último card: fecha a pilha com o botão de voltar, no lugar da seta. */
  ultimo?: boolean;
}

const { projeto, ultimo = false } = Astro.props;
const d = projeto.data;
const { Content } = await render(projeto);

// Screenshot pelo id do projeto, como em ProjetoLinha.
const screenshots = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/projetos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true },
);
const screenshot = Object.entries(screenshots).find(([caminho]) =>
  caminho.includes(`/${projeto.id}.`),
)?.[1].default;

// A mensagem já diz de qual projeto a pessoa veio.
const whatsapp = linkWhatsApp(
  `Olá, João. Vi o projeto ${d.titulo} no seu site e quero conversar sobre um site para o meu negócio.`,
);

const tituloId = `cartao-${projeto.id}`;

// Ressalva temporária de um projeto só: não vale um campo novo no schema.
const notaMedicao =
  projeto.id === 'barbearia-elliot'
    ? 'O iframe do Google Maps responde por cerca de 600 KB. Estou trocando por imagem estática mais link, o mesmo padrão que já apliquei ao Cal.com neste projeto.'
    : undefined;
---

{/*
  `cartao-pilha`, e não `cartao`, porque o rodapé já usa `.cartao`. O
  empilhamento é feito pela página, em /projetos/.
*/}
<section
  class="cartao-pilha claro painel"
  id={projeto.id}
  aria-labelledby={tituloId}
>
  <article class="caso casca">
    <p class="rotulo">Projeto {d.tipo} · {d.periodo}</p>
    <h2 id={tituloId}>{d.titulo}</h2>
    <p class="resumo medida">{d.resumo}</p>

    {/*
      Mesmo `transition:name` da linha na home: o screenshot anima de um
      tamanho para o outro na troca de página. A div existe só para carregar o
      nome, porque um componente do Astro não repassa atributos que não declara.
    */}
    {
      screenshot && (
        <div transition:name={`screenshot-${projeto.id}`}>
          <VideoProjeto
            id={projeto.id}
            imagem={screenshot}
            alt={d.screenshotAlt ?? `Captura de tela do projeto ${d.titulo}`}
          />
        </div>
      )
    }

    <p class="acoes">
      <a class="btn" href={d.demo} target="_blank" rel="noopener">
        Abrir o site<span class="vh"> (abre em nova aba)</span>
      </a>
      <a class="btn btn--fantasma" href={d.repo} target="_blank" rel="noopener">
        Ver o código<span class="vh"> (abre em nova aba)</span>
      </a>
    </p>

    <section aria-labelledby={`faz-${projeto.id}`} class="bloco medida" data-revela>
      <h3 id={`faz-${projeto.id}`}>O que o site faz</h3>
      <p><b>Objetivo:</b> {d.problema}</p>
      {d.destaques && <Destaques itens={d.destaques} />}
    </section>

    <section aria-labelledby={`desafio-${projeto.id}`} class="bloco medida" data-revela>
      <h3 id={`desafio-${projeto.id}`}>O desafio</h3>
      <p>{d.desafio}</p>
    </section>

    {
      d.aprendizado && (
        <section
          aria-labelledby={`aprendizado-${projeto.id}`}
          class="bloco medida"
          data-revela
        >
          <h3 id={`aprendizado-${projeto.id}`}>O que aprendi</h3>
          <p>{d.aprendizado}</p>
        </section>
      )
    }

    {/* Chamada antes da parte técnica: é onde quem vai contratar para de ler. */}
    <section aria-labelledby={`chamada-${projeto.id}`} class="chamada" data-revela>
      <h3 id={`chamada-${projeto.id}`}>Quer um site assim para o seu negócio?</h3>
      {
        whatsapp ? (
          <a class="btn" href={whatsapp} target="_blank" rel="noopener">
            <Icone nome="whatsapp" />
            Chamar no WhatsApp<span class="vh"> (abre em nova aba)</span>
          </a>
        ) : (
          <a class="btn" href="/#contato">
            Falar comigo
          </a>
        )
      }
    </section>

    <section aria-labelledby={`tecnico-${projeto.id}`} class="bloco medida" data-revela>
      <h3 id={`tecnico-${projeto.id}`}>Detalhes técnicos</h3>
      <p class="stack">Feito com {d.stack.join(', ')}.</p>
      <Content />
      <MedicaoProjeto
        pesoKb={d.pesoKb}
        pesoAproximado={d.pesoAproximado}
        jsKb={d.jsKb}
        loadS={d.loadS}
        nota={notaMedicao}
      />
    </section>

    {/*
      Fecho do card, no mesmo lugar nos três: a seta para continuar rolando,
      ou, no último, o botão que volta para a página principal.
    */}
    {
      ultimo ? (
        <p class="fecho">
          <a class="btn" href="/">
            Voltar para a página principal
          </a>
        </p>
      ) : (
        <p class="fecho proximo">
          {/*
            "Role" com mouse e "Arraste" no toque, trocados por media query, sem
            JavaScript: o leitor de tela lê só o texto visível.
          */}
          <span class="com-mouse">Role para ver o próximo projeto</span>
          <span class="com-toque">Arraste para ver o próximo projeto</span>
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d="M12 4v13m0 0-5-5m5 5 5-5" />
          </svg>
        </p>
      )
    }
  </article>
</section>

<style>
  .caso {
    display: flex;
    flex-direction: column;
    gap: var(--sp-l);
    padding-block: var(--sp-section);
  }

  .resumo {
    font-size: var(--step-1);
    color: var(--ink-muted);
  }

  .acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-s);
  }

  .bloco {
    display: flex;
    flex-direction: column;
    gap: var(--sp-s);
  }

  h2 {
    font-size: var(--step-3);
  }

  .bloco h3,
  .chamada h3 {
    font-size: var(--step-2);
  }

  .bloco b {
    font-weight: 700;
  }

  .stack {
    color: var(--ink-muted);
  }

  /* Sem vidro fosco: dentro do painel claro não há chuva atrás para borrar. */
  .chamada {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-m);
    padding: var(--sp-l);
    background: var(--surface);
    border: 1px solid var(--linha-suave);
    border-radius: var(--radius-card);
  }

  .fecho {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: var(--sp-m);
  }

  /* A seta é uma dica, não uma ação: menor e em texto secundário. */
  .proximo {
    gap: var(--sp-2xs);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }

  .com-mouse {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .com-mouse {
      display: inline;
    }

    .com-toque {
      display: none;
    }
  }
</style>
