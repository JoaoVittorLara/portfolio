const icone = icones[nome];
---

<svg
  class:list={['icone', classe]}
  viewBox={icone.viewBox}
  width="18"
  height="18"
  fill="currentColor"
  fill-rule={icone.regra}
  aria-hidden="true"
  focusable="false"
>
  {icone.caminhos.map((d) => <path d={d} />)}
</svg>

<style>
  .icone {
    flex: none;
    display: block;
  }
</style>
